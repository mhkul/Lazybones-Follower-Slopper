<Project><PropertyGroup><AutoFollowerRoot>$(MSBuildThisFileDirectory)</AutoFollowerRoot><AutoFollowerFoundationProject>$(AutoFollowerRoot)src/Foundation/Foundation.csproj</AutoFollowerFoundationProject><AutoFollowerFoundationProject Condition="Exists('$(AutoFollowerRoot)Foundation/Foundation.csproj')">$(AutoFollowerRoot)Foundation/Foundation.csproj</AutoFollowerFoundationProject><TargetFramework>net8.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><TreatWarningsAsErrors>true</TreatWarningsAsErrors><Deterministic>true</Deterministic></PropertyGroup></Project>
